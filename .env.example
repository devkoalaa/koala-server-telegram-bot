# Token do bot, gerado pelo @BotFather.
BOT_TOKEN=
# Único chat autorizado a usar o bot (o seu Chat ID).
ALLOWED_CHAT_ID=
# Banco do koala-fit com um usuário somente leitura (lembrete e resumo semanal).
KOALA_FIT_DATABASE_URL=
# Usuário que só grava nas tabelas de peso/composição (relatório da balança).
KOALA_FIT_WRITER_DATABASE_URL=
# Opcionais (HH:MM, fuso de São Paulo):
# DAILY_SUMMARY_TIME=08:00
# TRAINING_REMINDER_TIME=18:00
# WEEKLY_SUMMARY_TIME=20:00   # aos domingos
# NOTIFY_PORT=8081
# SITE_CHECK_INTERVAL_SECONDS=60
# SCALE_REPORTS_RETENTION_DAYS=30
# Garagem (fundo da troca de carro). A chave é a mesma de BOT_CHAVE no
# ~/apps/garagem/.env; sem ela os comandos /guardar, /retirar, /fundo e
# /parcela só avisam que não estão configurados.
GARAGEM_BOT_CHAVE=
# GARAGEM_URL=http://garagem:3003
# GARAGEM_REMINDER_TIME=19:00   # às sextas, se a semana não fechou
